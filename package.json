{
  "name": "vippi-leads",
  "private": true,
  "version": "0.1.0",
  "description": "Vippi Leads — demo MVP: lead response control for Tashkent real estate",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:shared": "pnpm --filter @vippi/shared run build",
    "dev": "pnpm build:shared && pnpm -r --parallel --filter @vippi/api --filter @vippi/web --filter @vippi/shared run dev",
    "lint": "eslint . --max-warnings=0 && pnpm --filter @vippi/web run lint:fsd",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "test:integration": "pnpm --filter @vippi/api run test:integration",
    "test:e2e": "pnpm --filter @vippi/web run test:e2e",
    "i18n:check": "pnpm --filter @vippi/web run i18n:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @vippi/api run db:migrate",
    "db:seed:demo": "pnpm --filter @vippi/api run db:seed:demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
