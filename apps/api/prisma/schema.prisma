generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

enum Role {
  OWNER
  HEAD_OF_SALES
  MANAGER
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LostReason {
  NO_ANSWER
  TOO_EXPENSIVE
  BOUGHT_ELSEWHERE
  NOT_INTERESTED
  DUPLICATE
  SPAM
  OTHER
}

enum LeadSource {
  INSTAGRAM
  TELEGRAM
  WEBSITE
  OLX
  PHONE
  WALK_IN
  REFERRAL
  OTHER
}

enum LeadCreatedVia {
  MANUAL
  CSV
  API
  SEED
}

enum SlaState {
  PENDING
  MET
  BREACHED
  EXEMPT
}

enum ContactChannel {
  CALL
  TELEGRAM
  INSTAGRAM
  WHATSAPP
  SMS
  EMAIL
  OTHER
}

enum Currency {
  UZS
  USD
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  OTHER
}

enum ActivityType {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  FIRST_CONTACT
  COMMENT
  SLA_BREACHED
  FIELDS_UPDATED
  AI_ANALYSIS_GENERATED
  AI_DRAFT_SENT
}

enum NotificationType {
  SLA_BREACHED
  LEAD_ASSIGNED
}

enum AiInsightKind {
  LEAD_ANALYSIS
  REPLY_DRAFT
  WEEKLY_SUMMARY
}

enum AiProviderName {
  GEMINI
  RULE_BASED
}

enum AiFallbackReason {
  NO_PROVIDER_CONFIGURED
  ORG_DISABLED
  LIMIT_EXCEEDED
  INPUT_TOO_LONG
  TIMEOUT
  PROVIDER_ERROR
  INVALID_OUTPUT
}

enum AuditActorType {
  USER
  API_KEY
  SYSTEM
}

model Organization {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                        String   @db.VarChar(100)
  timezone                    String   @default("Asia/Tashkent") @db.VarChar(64)
  defaultLocale               String   @default("ru") @db.VarChar(2)
  isDemo                      Boolean  @default(false)
  aiExternalProcessingEnabled Boolean  @default(false)
  nextLeadNumber              Int      @default(1)
  createdAt                   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime @updatedAt @db.Timestamptz(3)

  memberships   Membership[]
  sessions      Session[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  leads         Lead[]
  activities    LeadActivity[]
  slaPolicy     SlaPolicy?
  notifications Notification[]
  aiInsights    AiInsight[]
  auditLogs     AuditLog[]
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String
  fullName     String    @db.VarChar(100)
  locale       String    @default("ru") @db.VarChar(2)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  membership          Membership?
  sessions            Session[]
  invitationsSent     Invitation[]   @relation("InvitedBy")
  invitationsAccepted Invitation[]   @relation("AcceptedUser")
  apiKeysCreated      ApiKey[]
  assignedLeads       Lead[]         @relation("LeadAssignee")
  createdLeads        Lead[]         @relation("LeadCreatedBy")
  firstResponses      Lead[]         @relation("LeadFirstResponseBy")
  activities          LeadActivity[]
  slaPoliciesUpdated  SlaPolicy[]
  notifications       Notification[]
  aiInsights          AiInsight[]
  auditLogs           AuditLog[]
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @unique @db.Uuid
  role           Role
  status         MembershipStatus @default(ACTIVE)
  deactivatedAt  DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
}

model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  organizationId    String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  expiresAt         DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  ip                String?   @db.Inet
  userAgent         String?   @db.VarChar(256)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  email          String    @db.Citext
  role           Role
  tokenHash      String    @unique @db.Char(64)
  invitedById    String?   @db.Uuid
  expiresAt      DateTime  @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  acceptedUserId String?   @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedUser User?        @relation("AcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model ApiKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String    @db.VarChar(50)
  prefix         String    @db.VarChar(16)
  keyHash        String    @unique @db.Char(64)
  createdById    String?   @db.Uuid
  lastUsedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]

  @@index([organizationId, revokedAt])
}

model Lead {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String          @db.Uuid
  number                Int
  fullName              String?         @db.VarChar(100)
  phone                 String?         @db.VarChar(16)
  source                LeadSource
  sourceDetail          String?         @db.VarChar(100)
  message               String?
  budgetAmount          BigInt?
  budgetCurrency        Currency?
  district              String?         @db.VarChar(32)
  propertyType          PropertyType?
  rooms                 Int?            @db.SmallInt
  status                LeadStatus      @default(NEW)
  lostReason            LostReason?
  lostComment           String?         @db.VarChar(500)
  assigneeId            String?         @db.Uuid
  createdById           String?         @db.Uuid
  createdVia            LeadCreatedVia
  externalId            String?         @db.VarChar(100)
  receivedAt            DateTime        @db.Timestamptz(3)
  firstResponseDueAt    DateTime        @db.Timestamptz(3)
  firstResponseAt       DateTime?       @db.Timestamptz(3)
  firstResponseById     String?         @db.Uuid
  firstResponseChannel  ContactChannel?
  slaState              SlaState        @default(PENDING)
  slaBreachedAt         DateTime?       @db.Timestamptz(3)
  possibleDuplicateOfId String?         @db.Uuid
  closedAt              DateTime?       @db.Timestamptz(3)
  searchText            String          @default("")
  deletedAt             DateTime?       @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee            User?          @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy           User?          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  firstResponseBy     User?          @relation("LeadFirstResponseBy", fields: [firstResponseById], references: [id], onDelete: SetNull)
  possibleDuplicateOf Lead?          @relation("LeadDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  duplicates          Lead[]         @relation("LeadDuplicate")
  activities          LeadActivity[]
  notifications       Notification[]
  aiInsights          AiInsight[]

  @@unique([organizationId, number])
  @@index([organizationId, status, receivedAt(sort: Desc)])
  @@index([organizationId, source, receivedAt])
}

model LeadActivity {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  leadId         String       @db.Uuid
  type           ActivityType
  actorUserId    String?      @db.Uuid
  body           String?
  payload        Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, createdAt(sort: Desc)])
}

model SlaPolicy {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @unique @db.Uuid
  firstResponseMinutes Int      @default(15)
  forgottenAfterHours  Int      @default(24)
  businessHoursEnabled Boolean  @default(false)
  workdays             Int[]    @default([1, 2, 3, 4, 5, 6]) @db.SmallInt
  workStart            String   @default("09:00") @db.VarChar(5)
  workEnd              String   @default("18:00") @db.VarChar(5)
  updatedById          String?  @db.Uuid
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model Notification {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  leadId         String?          @db.Uuid
  payload        Json
  dedupeKey      String           @unique @db.VarChar(200)
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model AiInsight {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  leadId         String?           @db.Uuid
  kind           AiInsightKind
  inputHash      String            @db.Char(64)
  promptVersion  String            @db.VarChar(32)
  locale         String            @db.VarChar(2)
  params         Json?
  provider       AiProviderName
  model          String?           @db.VarChar(64)
  isFallback     Boolean
  fallbackReason AiFallbackReason?
  output         Json
  latencyMs      Int
  inputTokens    Int?
  outputTokens   Int?
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, leadId, kind, createdAt(sort: Desc)])
}

model AuditLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?        @db.Uuid
  actorType      AuditActorType
  actorUserId    String?        @db.Uuid
  actorApiKeyId  String?        @db.Uuid
  action         String         @db.VarChar(64)
  entityType     String?        @db.VarChar(32)
  entityId       String?        @db.Uuid
  subjectHash    String?        @db.Char(64)
  metadata       Json?
  ip             String?        @db.Inet
  userAgent      String?        @db.VarChar(256)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser    User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKey  ApiKey?       @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
}
