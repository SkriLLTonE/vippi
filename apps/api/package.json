{
  "name": "@vippi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json && node scripts/dev.mjs",
    "start": "node dist/src/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "node scripts/prepare-test-db.mjs && vitest run --project integration",
    "test:coverage": "node scripts/prepare-test-db.mjs && vitest run --coverage",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed:demo": "node dist/prisma/seed/demo.js"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@nestjs/common": "~11.2.7",
    "@nestjs/core": "~11.2.7",
    "@nestjs/platform-express": "~11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "~11.4.7",
    "@prisma/client": "~6.19.3",
    "@vippi/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "papaparse": "^5.7.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "~6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "~11.2.7",
    "@swc/core": "^1.16.18",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
