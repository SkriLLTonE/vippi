# Copy to .env and adjust. Never commit .env.

# --- Database (docker compose service "db") ---
POSTGRES_USER=vippi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vippi
POSTGRES_PORT=5432
# Used by the API when running on the host (pnpm dev). Inside docker compose it is overridden.
DATABASE_URL=postgresql://vippi:change-me-local-only@localhost:5432/vippi
# Used by integration/e2e tests (database is created by infra/postgres/init).
DATABASE_URL_TEST=postgresql://vippi:change-me-local-only@localhost:5432/vippi_test

# --- API ---
NODE_ENV=development
API_PORT=3000
# Origin check (CSRF) and invitation links. Docker: http://localhost:8080, dev: http://localhost:5173
PUBLIC_APP_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
TRUST_PROXY=false
LOG_LEVEL=info
SWAGGER_ENABLED=true
SLA_CRON_ENABLED=true
SLA_SCAN_BATCH_SIZE=500
INTAKE_RATE_LIMIT_PER_MIN=60
AUTH_IP_RATE_LIMIT_PER_MIN=30
EXPORT_MAX_ROWS=50000
# Cut-line feature flags (ADR-020), comma separated:
# AUDIT_LOG_UI,WEEKLY_SUMMARY,BUSINESS_HOURS,DAILY_CHART,CSV_IMPORT_PREVIEW,DEAL_SCORE
DISABLED_FEATURES=

# --- AI (Google Gemini is the only provider in MVP; empty key => rule-based fallback) ---
AI_PROVIDER=none
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=4000
AI_DAILY_REQUEST_LIMIT_PER_ORG=200
AI_DAILY_TOKEN_LIMIT_PER_ORG=300000
AI_USER_HOURLY_LIMIT=30

# --- Demo seed (synthetic data only) ---
DEMO_SEED_PASSWORD=demo-password-2026

# --- Web (build time) ---
VITE_API_BASE_URL=/api/v1
VITE_DEFAULT_LOCALE=ru
WEB_PORT=8080
