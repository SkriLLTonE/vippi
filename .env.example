# Copy to .env and adjust. Never commit .env.

# --- Database (docker compose service "db") ---
POSTGRES_USER=vippi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vippi
POSTGRES_PORT=5432
# Used by the API when running on the host (pnpm dev). Inside docker compose it is overridden.
DATABASE_URL=postgresql://vippi:change-me-local-only@localhost:5432/vippi
# Used by integration/e2e tests (database is created by infra/postgres/init).
DATABASE_URL_TEST=postgresql://vippi:change-me-local-only@localhost:5432/vippi_test

# --- API ---
NODE_ENV=development
API_PORT=3000
# Origin check (CSRF) and invitation links for the API on the host (dev: http://localhost:5173).
# docker compose ignores it: there the origin is http://localhost:${WEB_PORT} or STACK_PUBLIC_URL.
PUBLIC_APP_URL=http://localhost:8080
# Empty => true when PUBLIC_APP_URL is https, false otherwise. Render: true.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
# Reverse-proxy hops in front of the API (Express "trust proxy"): false/0 = none, true = 1.
# docker compose (nginx): true. Render: 3 (Cloudflare -> load balancer -> in-instance proxy).
TRUST_PROXY=false
# Single-origin mode (root Dockerfile / Render, ADR-022): the API also serves the built SPA from this directory.
WEB_DIST_DIR=
# Render injects PORT and RENDER_EXTERNAL_URL; they are used when API_PORT / PUBLIC_APP_URL are empty.
LOG_LEVEL=info
SWAGGER_ENABLED=true
SLA_CRON_ENABLED=true
SLA_SCAN_BATCH_SIZE=500
INTAKE_RATE_LIMIT_PER_MIN=60
AUTH_IP_RATE_LIMIT_PER_MIN=30
EXPORT_MAX_ROWS=50000
# Cut-line feature flags (ADR-020), comma separated:
# AUDIT_LOG_UI,WEEKLY_SUMMARY,BUSINESS_HOURS,DAILY_CHART,CSV_IMPORT_PREVIEW,DEAL_SCORE
DISABLED_FEATURES=

# --- AI (Google Gemini is the only provider in MVP; empty key => rule-based fallback) ---
AI_PROVIDER=none
AI_MODEL=gemini-3.5-flash-lite
# Optional for Gemini 3.x: minimal | low | medium | high (unset = model default)
AI_THINKING_LEVEL=
GEMINI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=4000
AI_DAILY_REQUEST_LIMIT_PER_ORG=200
AI_DAILY_TOKEN_LIMIT_PER_ORG=300000
AI_USER_HOURLY_LIMIT=30

# --- Demo seed (synthetic data only) ---
DEMO_SEED_PASSWORD=demo-password-2026
# Container start (apps/api/docker-entrypoint.sh): off | if-missing (seed once, Render) | reset (recreate every start)
DEMO_SEED_ON_START=off

# --- Web ---
# Host port of the web container (docker compose). The web app itself reads VITE_* values
# (VITE_API_BASE_URL=/api/v1, VITE_DEFAULT_LOCALE=ru by default) only from apps/web/.env.local.
WEB_PORT=8080
# Dev server proxy target for /api (vite dev / vite preview).
API_PROXY_TARGET=http://localhost:3000
